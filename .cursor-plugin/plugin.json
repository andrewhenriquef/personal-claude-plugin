  "version": "1.19.0",
  "author": {
    "name": "Andrew Oliveira"
  },
  "repository": "https://github.com/andrewhenriquef/personal-claude-plugin",
  "license": "MIT",
  "keywords": [
    "planning",
    "prd",
    "user-stories",
    "interview",
    "productivity",
    "mermaid",
    "diagrams",
    "refactoring",
    "code-simplification",
    "code-review",
    "security",
    "lint",
    "testing",
    "database",
    "migrations",
    "performance",
    "dependencies",
    "supply-chain",
    "reliability",
    "orchestration"
  ],
  "skills": [
    "./skills/planning/feature-planning",
    "./skills/planning/implementation-planning",
    "./skills/productivity/interview",
    "./skills/productivity/grammar-review",
    "./skills/productivity/product-interrogatory",
    "./skills/productivity/understand-the-intent",
    "./skills/design-doc-mermaid",
    "./skills/code-reviewing/code-simplify",
    "./skills/code-reviewing/security-analysis",
    "./skills/code-reviewing/static-analysis",
    "./skills/code-reviewing/test-analysis",
    "./skills/code-reviewing/data-and-migration-analysis",
    "./skills/code-reviewing/performance-analysis",
    "./skills/code-reviewing/dependency-analysis",
    "./skills/code-reviewing/reliability-analysis",
    "./skills/code-reviewing/review-orchestrator"
  ],
  "agents": "./.cursor-plugin/agents/",
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp?client=andrew-skills-plugin",
      "headers": {
        "Authorization": "${CONTEXT7_API_KEY}"
      }
    }
  },
  "variables": {
    "type": "object",
    "properties": {
      "CONTEXT7_API_KEY": {
        "type": "string",
        "title": "CONTEXT7_API_KEY",
        "default": ""
      }
    }
  }
